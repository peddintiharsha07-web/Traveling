# Copy to .env and edit. Never commit .env.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# The app refuses to start with DJANGO_DEBUG=False while this is still a placeholder.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Set to True only when the site is served over HTTPS (production).
# Turns on secure cookies, HTTPS redirect and HSTS. Needs a proxy that sets X-Forwarded-Proto.
DJANGO_HTTPS=False

# Email (password reset). By default messages are printed in the terminal running the server.
# For real email, use the SMTP backend and fill in your provider's details:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Unexpected Travel <help@example.com>

# Find Help works with OpenStreetMap services out of the box (no key needed).
# Optional overrides if you use your own provider or a self-hosted instance:
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
